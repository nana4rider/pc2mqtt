  "license": "ISC",
  "main": "dist/index.js",
  "type": "module",
  "homepage": "https://github.com/nana4rider/pc2mqtt",
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "start": "node dist/index",
    "build": "node build.js",
    "type-check": "tsc",
    "lint": "eslint --max-warnings 0 && prettier . --check",
    "lint:fix": "eslint --fix && prettier . --write",
    "test": "vitest run",
    "prepare": "lefthook install || true",
    "generate-config-schema": "tsx --env-file=.env generate-config-schema.ts"
  },
  "dependencies": {
    "envalid": "^9.0.0",
    "ip-address": "^10.7.5",
    "mqtt": "^5.16.1",
    "node-ssh": "^13.2.1",
    "ping": "^1.0.0",
    "winston": "^3.19.0",
    "wol": "^1.0.7"
  },
  "devDependencies": {
    "@esbuild-plugins/tsconfig-paths": "^0.1.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/ssh2": "^1.15.6",
    "@types/wol": "^1.0.4",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "lefthook": "^2.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "typescript-json-schema": "^0.68.0",
    "vitest": "^5.0.5"
  }
